---
// Fonts are self-hosted (SIL OFL 1.1) so visitors' browsers never contact Google.
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/inter/700.css";
import "@fontsource/space-grotesk/500.css";
import "@fontsource/space-grotesk/600.css";
import "@fontsource/space-grotesk/700.css";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** "website" for the home page, "article" for guides. */
  type?: "website" | "article";
  /** True for pages search engines should skip (the 404 page). */
  noindex?: boolean;
}
const { title, description, type = "website", noindex = false } = Astro.props;
// Absolute URLs on the canonical (non-www) domain set as `site` in astro.config.mjs.
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
// Markdown twins generated by @dualmark/astro (astro.config.mjs) for AI agents: home, /guides and each guide.
const path = Astro.url.pathname.replace(/\/$/, "");
const markdownPath = path === "" ? "/index.md" : /^\/guides(\/[^/]+)?$/.test(path) ? `${path}.md` : undefined;
// LaunchOG board: og-site.png (1200 × 630) for the home page and every page without its own.
const ogImage = Astro.site ? new URL("/og-site.png", Astro.site).href : "/og-site.png";
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="theme-color" content="#1C1C1C">
<meta property="og:type" content={type}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:site_name" content="Furl">
{canonical && <meta property="og:url" content={canonical}>}
<meta property="og:image" content={ogImage}>
<meta property="og:image:type" content="image/png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Furl. Get your Mac's space back. Without the guesswork.">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogImage}>
{noindex ? <meta name="robots" content="noindex"> : canonical && <link rel="canonical" href={canonical}>}
{markdownPath && !noindex && <link rel="alternate" type="text/markdown" href={markdownPath}>}
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<slot />
</body>
</html>
