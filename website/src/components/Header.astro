---
import { site } from "../site.config";

// Landing board: the header nav is Features and Guides only; Privacy, Terms
// and Refunds live in the footer, and Download is the pricing entry point.
const onGuides = Astro.url.pathname.startsWith("/guides");
---
<header class="site-header">
  <div class="header-inner">
    <a href="/" class="brand">
      <svg width="34" height="34" viewBox="0 0 64 64" aria-hidden="true"><rect width="64" height="64" rx="14.5" fill="#1C1C1C"></rect><path d="M26 52 V26 a12 12 0 0 1 12 -12" fill="none" stroke="#F2F2EE" stroke-width="6" stroke-linecap="round"></path><path d="M38 14 a7 7 0 0 1 0 14 a3.5 3.5 0 0 1 0 -7" fill="none" stroke="#5FE3B0" stroke-width="6" stroke-linecap="round"></path><path d="M17 34 H35" fill="none" stroke="#F2F2EE" stroke-width="6" stroke-linecap="round"></path></svg>
      <span class="brand-name">Furl</span>
    </a>
    <nav id="site-nav" class="site-nav" aria-label="Main">
      <a href="/#features">Features</a>
      <a href="/guides/" aria-current={onGuides ? "page" : undefined}>Guides</a>
      <a href="/#pricing" class="nav-download">Download</a>
    </nav>
    <a href={site.githubUrl} class="github-link" aria-label="Furl on GitHub">
      <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="#181717" d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"></path></svg>
      <span class="github-label" aria-hidden="true">GitHub</span>
    </a>
    <a href="/#pricing" class="btn-dark header-download">Download</a>
    <button type="button" class="menu-button" aria-label="Menu" aria-expanded="false" aria-controls="site-nav">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1A1A1A" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
    </button>
  </div>
</header>

<script>
  import "../scripts/menu";
</script>
