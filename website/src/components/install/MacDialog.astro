---
/* A macOS alert drawn in HTML/CSS for the install help steps. The primary button is ringed in mint. */
interface Props {
  title: string;
  body: string;
  primary: string;
  secondary: string;
}
const { title, body, primary, secondary } = Astro.props;
---
<div class="mac-dialog" aria-hidden="true">
  <svg width="52" height="52" viewBox="0 0 64 64"><rect width="64" height="64" rx="14.5" fill="#1C1C1C"></rect><path d="M26 52 V26 a12 12 0 0 1 12 -12" fill="none" stroke="#F2F2EE" stroke-width="6" stroke-linecap="round"></path><path d="M38 14 a7 7 0 0 1 0 14 a3.5 3.5 0 0 1 0 -7" fill="none" stroke="#5FE3B0" stroke-width="6" stroke-linecap="round"></path><path d="M17 34 H35" fill="none" stroke="#F2F2EE" stroke-width="6" stroke-linecap="round"></path></svg>
  <strong class="mac-dialog-title">{title}</strong>
  <span class="mac-dialog-body">{body}</span>
  <div class="mac-dialog-buttons">
    <span class="mac-dialog-btn mac-dialog-primary mac-ring">{primary}</span>
    <span class="mac-dialog-btn mac-dialog-secondary">{secondary}</span>
  </div>
</div>
