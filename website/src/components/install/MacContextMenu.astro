---
/* A Finder icon with its Control-click menu drawn in HTML/CSS, for the Sonoma install steps. */
---
<div class="mac-context" aria-hidden="true">
  <div class="mac-context-icon">
    <span><svg width="56" height="56" viewBox="0 0 64 64"><rect width="64" height="64" rx="14.5" fill="#1C1C1C"></rect><path d="M26 52 V26 a12 12 0 0 1 12 -12" fill="none" stroke="#F2F2EE" stroke-width="6" stroke-linecap="round"></path><path d="M38 14 a7 7 0 0 1 0 14 a3.5 3.5 0 0 1 0 -7" fill="none" stroke="#5FE3B0" stroke-width="6" stroke-linecap="round"></path><path d="M17 34 H35" fill="none" stroke="#F2F2EE" stroke-width="6" stroke-linecap="round"></path></svg></span>
    <span class="mac-context-name">Furl</span>
  </div>
  <div class="mac-context-menu">
    <div class="mac-context-item is-selected">Open</div>
    <div class="mac-context-item">Show Package Contents</div>
    <div class="mac-context-sep"></div>
    <div class="mac-context-item">Move to Trash</div>
    <div class="mac-context-item">Get Info</div>
  </div>
</div>
