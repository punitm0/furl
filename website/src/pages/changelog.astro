---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site, githubPath } from "../site.config";
import { releases, type ChangeItem } from "../data/changelog";

const releasesUrl = githubPath("/releases");
// Until site.downloadUrl is set, Download goes to the pricing card on the home page.
const downloadUrl = site.downloadUrl || "/#pricing";

const groups: { key: "new" | "improved" | "fixed"; label: string }[] = [
  { key: "new", label: "New" },
  { key: "improved", label: "Improved" },
  { key: "fixed", label: "Fixed" },
];
const githubIcon = `<svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path fill="#181717" d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"></path></svg>`;
const items = (r: (typeof releases)[number], key: "new" | "improved" | "fixed"): ChangeItem[] => r[key] ?? [];
---
<Base
  title="Changelog · Furl"
  description="What's new in Furl. Every version, newest first. Furl checks for updates once a day and installs them when you click. You can also follow releases on GitHub."
>
  <Header />
  <main id="main" class="doc-page changelog-page">
    <div class="changelog-hero">
      <div class="doc-hero">
        <span class="doc-eyebrow">CHANGELOG</span>
        <h1>What's new in Furl</h1>
        <p><span class="only-desktop">Every version, newest first. Furl checks for updates once a day and installs them when you click. You can also follow releases on GitHub.</span><span class="only-mobile">Every version, newest first. Use Check for Updates in the app, or follow releases on GitHub.</span></p>
      </div>
      <a href={releasesUrl} class="btn-outline only-desktop-flex"><Fragment set:html={githubIcon} />Watch releases</a>
    </div>

    <span class="changelog-label only-desktop">SHIPPED</span>
    {releases.map((r, index) => (
      <article id={r.version} class="release">
        <div class="release-side">
          <a href={`#${r.version}`} class="release-version">{r.version}</a>
          {index === 0 && <span class="release-latest">Latest</span>}
          <span class="release-date">{r.date}</span>
        </div>
        <div class="release-body">
          <div class="release-intro">
            <h2>{r.title}</h2>
            <p>{r.lead}</p>
          </div>
          {index === 0 ? (
            <div class="release-download">
              <a href={downloadUrl} class="btn-dark release-download-btn">Download {r.version}</a>
              <a href={releasesUrl} class="release-github only-desktop">Release on GitHub →</a>
              {r.meta && <span class="release-meta">{r.meta}</span>}
            </div>
          ) : (
            <div class="release-download">
              <a href={releasesUrl} class="release-github">Release on GitHub →</a>
            </div>
          )}
          {groups.filter((g) => items(r, g.key).length > 0).map((g) => (
            <div class={`release-group release-group-${g.key}`}>
              <span class="release-chip">{g.label}</span>
              <ul>
                {items(r, g.key).map((item) => (
                  <li>
                    <span class="release-dot" aria-hidden="true"></span>
                    <span>{item.lead && <strong>{item.lead}.</strong>}{item.lead ? " " : ""}{item.text}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
          {r.knownIssue && (
            <div class="release-note">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#63635D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 11v6M12 7.5v.5"></path></svg>
              <span><strong>Known issue.</strong> Furl isn't notarized yet, so the first launch takes one extra step. <a href="/install">How to open Furl →</a></span>
            </div>
          )}
        </div>
      </article>
    ))}
  </main>
  <Footer />
</Base>
